# Supabase — Project settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-only. Used by POST /api/leads to write into the `leads` table.
# Never expose this key to the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# Public URL of the deployment, used for metadata and (later) the PDF link.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Contact details shown on the landing page.
# WhatsApp in international format, digits only: country + operator + number.
NEXT_PUBLIC_WHATSAPP_NUMBER="584120000000"
NEXT_PUBLIC_CONTACT_EMAIL="hola@invita.com"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/invita"
