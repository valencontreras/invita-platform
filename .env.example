# Invita — variables de entorno
#
# Copia este archivo a `.env.local` y completa los valores:
#   cp .env.example .env.local
#
# `.env.local` nunca se sube al repositorio (ver .gitignore).

# --- Sitio -------------------------------------------------------------------
# URL pública del sitio. Acepta `invita.app` o `https://invita.app`.
# Se usa como `metadataBase` en app/layout.tsx (Open Graph e imágenes absolutas).
NEXT_PUBLIC_SITE_URL=https://invita.app

# --- Contacto -----------------------------------------------------------------
# Número de WhatsApp en formato internacional y solo dígitos (ej. 584120000000).
# Si se deja vacío, los botones de WhatsApp llevan al formulario `#cotizar`
# en lugar de a un enlace roto (ver lib/content/site.ts).
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Correo y perfil de Instagram del pie de página. Si se dejan vacíos, el enlace
# correspondiente simplemente no se muestra.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=

# --- Supabase -----------------------------------------------------------------
# Conexión con la base de datos, la autenticación y el almacenamiento de fotos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo para el servidor: la usa `POST /api/leads` para guardar los leads.
# Nunca debe exponerse al navegador ni llevar el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
